{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FileConfig",
  "$defs": {
    "FileApp": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "package-id": {
          "title": "Package-Id",
          "type": "string"
        },
        "app-name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "App-Name"
        },
        "patch-source": {
          "default": "MorpheApp/morphe-patches",
          "title": "Patch-Source",
          "type": "string"
        },
        "patch-version": {
          "default": "latest",
          "pattern": "^(latest|dev|v?\\d+\\.\\d+\\.\\d+(-dev\\.\\d+)?)$",
          "title": "Patch-Version",
          "type": "string"
        },
        "version": {
          "default": "latest",
          "pattern": "^(latest|dev|v?\\d+(\\.\\d+)*(-.*)?)$",
          "title": "Version",
          "type": "string"
        },
        "archive-dlurl": {
          "default": "",
          "title": "Archive-Dlurl",
          "type": "string"
        },
        "included-patches": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "additionalProperties": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "type": "object"
              }
            ]
          },
          "title": "Included-Patches",
          "type": "array"
        },
        "excluded-patches": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Excluded-Patches",
          "type": "array"
        },
        "exclusive-patches": {
          "default": false,
          "title": "Exclusive-Patches",
          "type": "boolean"
        },
        "patcher-args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Patcher-Args",
          "type": "array"
        }
      },
      "required": [
        "package-id"
      ],
      "title": "FileApp",
      "type": "object"
    }
  },
  "additionalProperties": {
    "$ref": "#/$defs/FileApp"
  },
  "properties": {
    "parallel-jobs": {
      "default": 1,
      "title": "Parallel-Jobs",
      "type": "integer"
    },
    "cli-version": {
      "default": "latest",
      "pattern": "^(latest|dev|v?\\d+\\.\\d+\\.\\d+(-dev\\.\\d+)?)$",
      "title": "Cli-Version",
      "type": "string"
    }
  },
  "type": "object"
}
